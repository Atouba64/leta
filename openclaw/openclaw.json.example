{
  "agents": {
    "list": [
      {
        "id": "leta",
        "default": true,
        "name": "Leta Ops",
        "workspace": "/home/zongo9/Documents/Github/projects/leta/openclaw/workspace",
        "model": "google/gemini-2.0-flash"
      }
    ],
    "defaults": {
      "model": {
        "primary": "google/gemini-2.0-flash"
      }
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "selfChatMode": true,
      "allowFrom": ["+14702526681"],
      "groupPolicy": "allowlist",
      "mediaMaxMb": 50,
      "debounceMs": 0
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "http": {
      "endpoints": {
        "chatCompletions": { "enabled": true }
      }
    },
    "auth": {
      "mode": "token",
      "token": "YOUR_OPENCLAW_GATEWAY_TOKEN"
    }
  },
  "plugins": {
    "entries": {
      "whatsapp": { "enabled": true }
    }
  }
}
