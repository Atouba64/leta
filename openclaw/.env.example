# Leta + OpenClaw — copy to openclaw/.env (never commit .env)
# Budget tip: use Google Gemini free tier via OpenClaw (see README.md)

# --- OpenClaw Gateway (local = $0 hosting) ---
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=YOUR_OPENCLAW_GATEWAY_TOKEN

# --- LLM (pick one; Gemini free tier recommended) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# --- Agent id (website + channels use agent "leta") ---
OPENCLAW_AGENT_ID=leta

# --- Optional: Firebase ops digest ---
OPENCLAW_OPS_ENABLED=false

# --- Leta AI bridge (functions/.env mirrors these for Cloud Functions) ---
LETA_AGENT_ENABLED=false
