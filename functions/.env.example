STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Leta AI assistant (website + app + messaging bridge — see ../openclaw/CHANNELS.md)
LETA_AGENT_ENABLED=false
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=YOUR_OPENCLAW_GATEWAY_TOKEN
OPENCLAW_AGENT_ID=leta

# Optional admin-only ops digest (separate toggle)
OPENCLAW_OPS_ENABLED=false

# Ops tracker (OPTIONAL — not used by Google Sheets workflow)
# Sheets pushes directly to GitHub via Apps Script. Only needed if you deploy POST /ops-tracker/save.
# Create a fine-grained PAT: Contents read+write on Atouba64/leta
GITHUB_TOKEN=
GITHUB_REPO_OWNER=Atouba64
GITHUB_REPO_NAME=leta
GITHUB_REPO_BRANCH=main
# Optional override; default is SHA-256 of PIN 1998
# OPS_TRACKER_PIN_HASH=
