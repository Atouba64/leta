rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function hasRole(role) {
      return signedIn() && userDoc().data.role == role;
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    function partnerTenant() {
      return userDoc().data.tenantId;
    }

    function canReadTicket(ticket) {
      return ticket.customerId == uid()
        || ticket.assignedTechId == uid()
        || ticket.remoteTechId == uid()
        || (hasRole('partner_dispatcher') && ticket.partnerId == partnerTenant())
        || hasRole('field_tech')
        || hasRole('remote_tech')
        || isAdmin();
    }

    function canWriteTicket(ticket) {
      return ticket.customerId == uid()
        || ticket.assignedTechId == uid()
        || ticket.remoteTechId == uid()
        || (hasRole('partner_dispatcher') && ticket.partnerId == partnerTenant())
        || isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow create: if signedIn() && userId == uid();
      allow update: if signedIn() && (userId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && canReadTicket(resource.data);
      allow create: if signedIn() && (
        (hasRole('customer') && request.resource.data.customerId == uid()) ||
        (hasRole('partner_dispatcher') && request.resource.data.partnerId == partnerTenant())
      );
      allow update: if signedIn() && canWriteTicket(resource.data);
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if signedIn() && canReadTicket(get(/databases/$(database)/documents/tickets/$(ticketId)).data);
        allow create: if signedIn() && canWriteTicket(get(/databases/$(database)/documents/tickets/$(ticketId)).data);
      }

      match /messages/{messageId} {
        allow read: if signedIn() && canReadTicket(get(/databases/$(database)/documents/tickets/$(ticketId)).data);
        allow create: if signedIn() && canReadTicket(get(/databases/$(database)/documents/tickets/$(ticketId)).data)
          && request.resource.data.senderId == uid();
      }
    }

    match /offers/{offerId} {
      allow read: if signedIn();
      allow create: if signedIn() && hasRole('field_tech');
      allow update: if signedIn() && (
        resource.data.techId == uid() ||
        isAdmin()
      );
    }

    match /live_sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.fieldTechId == uid() ||
        resource.data.remoteTechId == uid() ||
        resource.data.partnerDispatcherId == uid() ||
        isAdmin()
      );

      match /signals/{signalId} {
        allow read, write: if signedIn();
      }
    }

    match /escalations/{escalationId} {
      allow read: if signedIn() && (hasRole('remote_tech') || hasRole('field_tech') || isAdmin());
      allow create: if signedIn() && hasRole('field_tech');
      allow update: if signedIn() && (hasRole('remote_tech') || isAdmin());
    }

    match /technician_applications/{applicationId} {
      allow read, write: if isAdmin();
    }

    match /mailing_list/{email} {
      allow read, write: if isAdmin();
    }
  }
}
